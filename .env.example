# AIDANN Environment Configuration
PROJECT_NAME="AIDANN-Backend"
VERSION=1.0.0

# API Keys (Institutional Secret)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT="your-project-id"
GOOGLE_CLOUD_LOCATION="global"
VERTEX_AI_MODEL_NAME="gemini-2.5-flash"
VERTEX_AI_REASONING_MODEL_NAME="gemini-2.5-pro"
VERTEX_AI_API_VERSION="v1"
VERTEX_AI_TEMPERATURE=0.2
VERTEX_AI_MAX_OUTPUT_TOKENS=8192
VERTEX_AI_USE_EXPRESS_MODE=True
VERTEX_AI_SERVICE_ACCOUNT_FILE=""
VERTEX_AI_SERVICE_ACCOUNT_JSON=""
VERTEX_AI_ENABLE_GOOGLE_SEARCH=False
VERTEX_AI_ENABLE_URL_CONTEXT=False
VERTEX_AI_ENABLE_CODE_EXECUTION=False

# System Infrastructure
REDIS_URL="redis://localhost:6379/0"
ENABLE_KILL_SWITCH=True

# Database / AlloyDB
DB_BACKEND="postgresql"
# Open-source/dev default (no Docker required):
DATABASE_URL="sqlite:///./aidann.db"
# Docker example:
# DATABASE_URL="postgresql+psycopg2://aidann_app:aidann_dev_password@postgres:5432/aidann"
DB_ECHO=False
DB_AUTO_CREATE=True
DB_AUTO_SEED=True
AIDAAN_HISTORY_WINDOW=5
ALLOYDB_ENABLED=False
ALLOYDB_USE_AUTH_PROXY=False
ALLOYDB_HOST="127.0.0.1"
ALLOYDB_PORT=5432
ALLOYDB_DATABASE="aidann"
ALLOYDB_USER="aidann_app"
ALLOYDB_PASSWORD=""
ALLOYDB_PROJECT_ID=""
ALLOYDB_REGION=""
ALLOYDB_CLUSTER_ID=""
ALLOYDB_INSTANCE_ID=""
ALLOYDB_INSTANCE_URI=""
ALLOYDB_SSL_MODE="require"

# MCP Configuration
# Leave MCP_SERVER_COMMAND unset to use the current Python interpreter (recommended for venvs).
# MCP_SERVER_COMMAND="python3"
MCP_SERVER_ARGS="app/services/aidaan/mcp/market.py"
# Recommended for open-source/dev: in-process MCP avoids stdio transport edge cases.
MCP_TRANSPORT="inprocess"

# LSEG Configuration
LSEG_API_BASE_URL="https://api.lseg.com/data"
LSEG_API_SNAPSHOT_PATH="snapshot"
LSEG_API_KEY=""
LSEG_API_TIMEOUT=5.0

# BigQuery / Data Warehouse
LDL_BIGQUERY_DATASET="ldl_v2"
LDL_BIGQUERY_TIMESTAMP_FIELD="event_ts"
LDL_BIGQUERY_BID_FIELD="bid"
LDL_BIGQUERY_ASK_FIELD="ask"
LDL_BIGQUERY_INSTRUMENT_FIELD="instrument"

# JWT
JWT_SECRET_KEY="your-256-bit-secret-here"
